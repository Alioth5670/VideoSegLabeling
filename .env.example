BACKEND_PORT=8010
PROJECTS_DIR=./projects

# Use mock for a portable first run. Set a real backend after SAM3 and checkpoints are available.
SAM_BACKEND=mock
SAM_DEVICE=cuda:0
CUDA_VISIBLE_DEVICES=0

SAM_REPO_PATH=./sam3
SAM_CHECKPOINT_PATH=./checkpoints/sam3.pt
SAM31_CHECKPOINT_PATH=./checkpoints/sam3.1_multiplex.pt
SAM_PRECISION=bfloat16

# Frontend dev server only. Release builds are served by FastAPI.
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://127.0.0.1:8010

# Set true when serving over HTTPS. Login sessions use HttpOnly cookies.
AUTH_COOKIE_SECURE=false

# Bound CPU frame cache and GPU backbone feature cache per video session.
SAM_FRAME_CACHE_SIZE=8
SAM_FEATURE_CACHE_SIZE=4
# Official tracker state CPU offload saves VRAM, with some tracking speed cost.
SAM_OFFLOAD_STATE_TO_CPU=true

# Detailed mask diagnostics may synchronize the GPU; enable only when debugging.
SAM_DEBUG_LOGGING=false
