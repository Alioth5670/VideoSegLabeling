# Prefer ./service.sh install-systemd to generate paths for this checkout.
[Unit]
Description=VideoSegLabeling
After=network.target

[Service]
Type=simple
User=YOUR_LOGIN_USER
WorkingDirectory=/opt/video-seg-labeling
ExecStart=/opt/video-seg-labeling/start.sh --foreground
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
